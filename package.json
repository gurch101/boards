{
  "name": "boards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "dev": "npm run build:client && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply boards-preview --local",
    "migrate:preview": "wrangler d1 migrations apply boards-preview --remote",
    "migrate:production": "wrangler d1 migrations apply boards-production --remote --env production",
    "deploy:preview": "npm run build:client && wrangler deploy",
    "deploy:production": "npm run build:client && wrangler deploy --env production",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "d1-admin": "file:../../d1-admin",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "hono": "^4.9.2",
    "lucide": "^1.33.0",
    "marked": "^18.0.10",
    "mermaid": "^11.17.0",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260819.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.0"
  }
}
